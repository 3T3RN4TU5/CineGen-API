{
  "info": {
    "name": "CineGen API",
    "description": "Full flow: register → catalog → generate → poll → credits → admin. Set {{baseUrl}} to your deployment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "email",
      "value": "demo+{{$timestamp}}@example.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "generationId",
      "value": ""
    },
    {
      "key": "imageUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", JSON.parse(pm.request.body.raw).email);",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"token\", d.token);",
                  "pm.collectionVariables.set(\"userId\", d.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status ok\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"token\", d.token);",
                  "pm.collectionVariables.set(\"userId\", d.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Models",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/models",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "models"]
            }
          }
        },
        {
          "name": "Presets",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/presets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "presets"]
            }
          }
        }
      ]
    },
    {
      "name": "Generations",
      "item": [
        {
          "name": "Create text-to-image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 accepted\", () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set(\"generationId\", pm.response.json().data.generation._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"text-to-image\",\n  \"modelKey\": \"flux-schnell\",\n  \"prompt\": \"a lighthouse on a rocky cliff at dusk\",\n  \"stylePreset\": \"cinematic\",\n  \"params\": {\n    \"aspectRatio\": \"16:9\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create text-to-video",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) pm.collectionVariables.set(\"generationId\", pm.response.json().data.generation._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"text-to-video\",\n  \"modelKey\": \"ltx-fast\",\n  \"prompt\": \"a red sports car on a rainy city street at night\",\n  \"cameraPreset\": \"dolly-in\",\n  \"stylePreset\": \"neon-noir\",\n  \"imageUrl\": null,\n  \"params\": {\n    \"duration\": 6,\n    \"aspectRatio\": \"16:9\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Upload image (image-to-video input)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set(\"imageUrl\", pm.response.json().data.imageUrl);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations/upload-image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations", "upload-image"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Create image-to-video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"image-to-video\",\n  \"modelKey\": \"seedance-i2v\",\n  \"prompt\": \"the scene slowly comes alive\",\n  \"cameraPreset\": \"orbit\",\n  \"imageUrl\": \"{{imageUrl}}\",\n  \"params\": {\n    \"duration\": 5,\n    \"aspectRatio\": \"auto\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get generation (poll every 5s)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations/{{generationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations", "{{generationId}}"]
            }
          }
        },
        {
          "name": "List my generations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations?page=1&limit=10&sort=-createdAt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "-createdAt"
                }
              ]
            }
          }
        },
        {
          "name": "Delete generation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generations/{{generationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "generations", "{{generationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Credits",
      "item": [
        {
          "name": "Balance + history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/credits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "credits"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin (use an admin token)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?search=example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"],
              "query": [
                {
                  "key": "search",
                  "value": "example.com"
                }
              ]
            }
          }
        },
        {
          "name": "Grant credits",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}/credits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "{{userId}}", "credits"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"reason\": \"Demo grant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Revoke credits",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}/credits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "{{userId}}", "credits"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -10,\n  \"reason\": \"Correction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "{{userId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "{{userId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "All generations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/generations?status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "generations"],
              "query": [
                {
                  "key": "status",
                  "value": "completed"
                }
              ]
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "stats"]
            }
          }
        },
        {
          "name": "All models",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/models",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "models"]
            }
          }
        },
        {
          "name": "Disable model",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/models/kling-v3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "models", "kling-v3"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
