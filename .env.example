NODE_ENV=development
PORT=5000
# Public URL, used to build the fal webhook URL (use your ngrok/cloudflared URL for local webhook testing)
API_BASE_URL=http://localhost:5000
# Comma-separated CORS allow list
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/cinegen
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

FAL_KEY=
# Verify fal webhook signatures (keep true in production)
FAL_WEBHOOK_VERIFY=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SIGNUP_FREE_CREDITS=20
DAILY_GENERATION_LIMIT=10
JOB_TIMEOUT_MINUTES=15

# In-process fallback poller. Set false on serverless hosts (Vercel) and use the cron endpoint instead.
ENABLE_POLLER=true
# Secret for GET /api/v1/internal/poll-jobs (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
LOG_LEVEL=info
